# npm's dependency install-script policy (allowScripts) can drift out of
# sync between environments when a semver range resolves a different patch
# version than the one pinned in package.json's allowScripts field. This
# project explicitly needs install scripts for @prisma/client, @prisma/engines,
# esbuild, prisma, and unrs-resolver (native binaries / codegen) to build at
# all, so the policy is bypassed outright rather than chasing version pins.
dangerously-allow-all-scripts=true
