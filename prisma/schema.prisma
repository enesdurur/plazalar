// Prisma schema for Plazalar Teknik Hizmetler CRM/CMMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  VIEWER
}

enum OperationType {
  ARIZA
  BAKIM
}

enum Currency {
  TRY
  USD
  EUR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdRecords MaintenanceRecord[] @relation("RecordCreatedBy")

  @@map("users")
}

model Plaza {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  machines             Machine[]
  periodicInspections  PeriodicInspection[]
  tenants              Tenant[]
  budgetSections       BudgetSection[]
  maintenancePlanItems MaintenancePlanItem[]
  inspectionPlanItems  InspectionPlanItem[]

  @@map("plazas")
}

model Tenant {
  id          String   @id @default(cuid())
  plazaId     String
  floor       String
  companyName String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plaza            Plaza                   @relation(fields: [plazaId], references: [id])
  maintenances     TenantMaintenance[]
  maintenanceItems TenantMaintenanceItem[]

  @@unique([plazaId, floor])
  @@index([plazaId])
  @@map("tenants")
}

// Kiracı Bakımları: Yıllık Bakım Planı / Periyodik (Fenni) Muayene ile aynı desen — her kiracı
// için bakım türü (Fancoil Bakımı, Elektrik Bakımı gibi; liste ileride genişleyebilir) bir
// TenantMaintenanceItem'dır ve haftalık (1-53) matris ile takip edilir.
model TenantMaintenanceItem {
  id             String   @id @default(cuid())
  tenantId       String
  label          String
  scheduledWeeks Int[]    @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekEntries TenantMaintenanceWeekEntry[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("tenant_maintenance_items")
}

model TenantMaintenanceWeekEntry {
  id        String   @id @default(cuid())
  itemId    String
  year      Int
  week      Int
  completed Boolean?
  note      String?
  updatedAt DateTime @updatedAt

  item TenantMaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, year, week])
  @@index([year, week])
  @@map("tenant_maintenance_week_entries")
}

model TenantMaintenance {
  id                  String    @id @default(cuid())
  tenantId            String
  maintenanceType     String
  period              String?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  responsiblePerson   String?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([nextMaintenanceDate])
  @@map("tenant_maintenances")
}

model Machine {
  id                String   @id @default(cuid())
  plazaId           String
  name              String
  brand             String?
  model             String?
  serialNo          String?
  quantity          Int      @default(1)
  feature           String?
  powerKw           Float?
  location          String?
  distributionPanel String?
  mccPanel          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plaza                Plaza                  @relation(fields: [plazaId], references: [id])
  records              MaintenanceRecord[]
  planEntries          MaintenancePlanEntry[]
  maintenancePlanItems MaintenancePlanItem[]
  inspectionPlanItems  InspectionPlanItem[]

  @@unique([plazaId, name])
  @@map("machines")
}

model MaintenancePlanEntry {
  id           String   @id @default(cuid())
  machineId    String
  year         Int
  month        Int
  // null = not tracked yet, true = yapıldı, false = yapılmadı
  completed    Boolean?
  note         String?
  cost         Decimal? @db.Decimal(12, 2)
  costCurrency Currency @default(TRY)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, year, month])
  @@index([year, month])
  @@map("maintenance_plan_entries")
}

model IssueType {
  id   String @id @default(cuid())
  name String @unique

  records MaintenanceRecord[]

  @@map("issue_types")
}

model Technician {
  id   String @id @default(cuid())
  name String @unique

  records MaintenanceRecord[]

  @@map("technicians")
}

model SparePart {
  id          String   @id @default(cuid())
  name        String   @unique
  defaultCost Decimal? @db.Decimal(12, 2)

  records MaintenanceRecord[]

  @@map("spare_parts")
}

model MaintenanceRecord {
  id                    String        @id @default(cuid())
  machineId             String
  operationType         OperationType
  issueTypeId           String?
  description           String
  technicianId          String?
  reportedAt            DateTime
  respondedAt           DateTime?
  finishedAt            DateTime?
  sparePartId           String?
  sparePartOther        String?
  sparePartQty          Int?
  sparePartCost         Decimal?      @db.Decimal(12, 2)
  sparePartCostCurrency Currency      @default(TRY)
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  machine    Machine     @relation(fields: [machineId], references: [id])
  issueType  IssueType?  @relation(fields: [issueTypeId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id])
  sparePart  SparePart?  @relation(fields: [sparePartId], references: [id])
  createdBy  User?       @relation("RecordCreatedBy", fields: [createdById], references: [id])

  @@index([machineId])
  @@index([reportedAt])
  @@index([operationType])
  @@map("maintenance_records")
}

model PeriodicInspection {
  id                 String    @id @default(cuid())
  plazaId            String
  code               String?
  name               String
  brand              String?
  reportNo           Int?
  period             String?
  technicalFeature   String?
  inspectionDate     DateTime?
  nextInspectionDate DateTime?
  location           String?
  responsiblePerson  String?
  cost               Decimal?  @db.Decimal(12, 2)
  costCurrency       Currency  @default(TRY)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plaza Plaza @relation(fields: [plazaId], references: [id])

  @@index([plazaId])
  @@index([nextInspectionDate])
  @@map("periodic_inspections")
}

// Yıllık Bakım Planı: Excel'deki "BAKIM" listesiyle birebir — her kalem (ör. Trafo İşletme
// Sorumluluğu, Jeneratör Bakımı) bir bakım firmasına ve yıllık tekrar sayısına sahip, isteğe
// bağlı olarak mevcut bir Machine kaydına bağlanabilir. Haftalık (1-53) matris ile takip edilir.
model MaintenancePlanItem {
  id             String   @id @default(cuid())
  plazaId        String
  machineId      String?
  label          String
  company        String?
  yearlyCount    Int?
  /**
   * Excel'de renkli/işaretli hücrelerin karşılık geldiği hafta numaraları (1-53) — bu kalemin
   * o yıl için planlanmış gerçekleşme haftaları. Yalnızca bu haftalarda onay kutusu gösterilir.
   */
  scheduledWeeks Int[]    @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plaza       Plaza                      @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  machine     Machine?                   @relation(fields: [machineId], references: [id])
  weekEntries MaintenancePlanWeekEntry[]

  @@unique([plazaId, label])
  @@index([plazaId])
  @@map("maintenance_plan_items")
}

model MaintenancePlanWeekEntry {
  id                    String   @id @default(cuid())
  itemId                String
  year                  Int
  /**
   * 1-53: Excel'deki aylara bölünmüş hafta numarası (bkz. lib/plan/weeks.ts)
   */
  week                  Int
  // null = boş, true = yapıldı, false = yapılmadı
  completed             Boolean?
  note                  String?
  cost                  Decimal? @db.Decimal(12, 2)
  costCurrency          Currency @default(TRY)
  /**
   * Bu bakımda kullanılan yedek parça varsa: maliyet + not. sparePartCost dolu olduğunda
   * matriste ayrı bir işaret gösterilir.
   */
  sparePartCost         Decimal? @db.Decimal(12, 2)
  sparePartCostCurrency Currency @default(TRY)
  sparePartNote         String?
  updatedAt             DateTime @updatedAt

  item MaintenancePlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, year, week])
  @@index([year, week])
  @@map("maintenance_plan_week_entries")
}

// Periyodik (Fenni) Muayene: Excel'deki "FENNİ MUAYENE" listesiyle birebir — aynı haftalık
// (1-53) matris deseni, MaintenancePlanItem ile paralel ama ayrı bir model (farklı sekme/anlam).
model InspectionPlanItem {
  id             String   @id @default(cuid())
  plazaId        String
  machineId      String?
  label          String
  company        String?
  yearlyCount    Int?
  /**
   * Excel'de renkli/işaretli hücrelerin karşılık geldiği hafta numaraları (1-53).
   */
  scheduledWeeks Int[]    @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plaza       Plaza                     @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  machine     Machine?                  @relation(fields: [machineId], references: [id])
  weekEntries InspectionPlanWeekEntry[]

  @@unique([plazaId, label])
  @@index([plazaId])
  @@map("inspection_plan_items")
}

model InspectionPlanWeekEntry {
  id                    String   @id @default(cuid())
  itemId                String
  year                  Int
  week                  Int
  completed             Boolean?
  note                  String?
  cost                  Decimal? @db.Decimal(12, 2)
  costCurrency          Currency @default(TRY)
  sparePartCost         Decimal? @db.Decimal(12, 2)
  sparePartCostCurrency Currency @default(TRY)
  sparePartNote         String?
  updatedAt             DateTime @updatedAt

  item InspectionPlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, year, week])
  @@index([year, week])
  @@map("inspection_plan_week_entries")
}

model Calibration {
  id                  String    @id @default(cuid())
  code                String?
  deviceName          String
  brand               String?
  model               String?
  serialNo            String?
  calibrationCompany  String?
  certificateNo       String?
  measurementRange    String?
  precision           String?
  lastCalibrationDate DateTime?
  nextCalibrationDate DateTime?
  location            String?
  responsiblePerson   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([nextCalibrationDate])
  @@map("calibrations")
}

model Verification {
  id                     String    @id @default(cuid())
  deviceName             String
  deviceSerialNo         String?
  usageLocation          String?
  receivedBy             String?
  verificationPeriod     String?
  referenceCertificateNo String?
  measurementRange       String?
  result                 String?
  verificationDate       DateTime?
  nextVerificationDate   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([nextVerificationDate])
  @@map("verifications")
}

// Gerçekleşen Bütçe: bölüm (A- Personel Giderleri, Yönetim Giderleri, Diğer Giderler gibi)
// bazında gider kalemleri. Her kalem ya "sözleşme bedeli belirli" (isFixedContract) olur —
// yıl başında fixedAmount girilir, sonraki aylarda sadece onay kutusu işaretlenir — ya da
// tutar her ay elle girilir (manualAmount).
model BudgetSection {
  id        String   @id @default(cuid())
  plazaId   String
  plaza     Plaza    @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  year      Int
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items BudgetLineItem[]

  @@unique([plazaId, year, name])
  @@map("budget_sections")
}

model BudgetLineItem {
  id              String        @id @default(cuid())
  sectionId       String
  section         BudgetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category        String?
  label           String
  monthlyBudget   Decimal       @db.Decimal(12, 2)
  isFixedContract Boolean       @default(false)
  fixedAmount     Decimal?      @db.Decimal(12, 2)
  fill            String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  entries     BudgetMonthEntry[]
  adjustments BudgetAdjustment[]

  @@unique([sectionId, label])
  @@map("budget_line_items")
}

model BudgetMonthEntry {
  id           String         @id @default(cuid())
  lineItemId   String
  lineItem     BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  month        Int
  /**
   * Sözleşme bedeli sabit kalemlerde: bu ay gerçekleşti mi (onay kutusu)
   */
  confirmed    Boolean        @default(false)
  /**
   * Sabit olmayan kalemlerde elle girilen tutar
   */
  manualAmount Decimal?       @db.Decimal(12, 2)
  updatedAt    DateTime       @updatedAt

  @@unique([lineItemId, month])
  @@map("budget_month_entries")
}

enum BudgetAdjustmentType {
  OVERTIME
  ABSENCE
}

/**
 * Sözleşmesi sabit bir kalemde bile o ay için ek kırılım (fazla mesai / eksik çalışma)
 * gerekebilir. OVERTIME kalemin ay tutarına eklenir, ABSENCE düşülür.
 */
model BudgetAdjustment {
  id         String               @id @default(cuid())
  lineItemId String
  lineItem   BudgetLineItem       @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  month      Int
  type       BudgetAdjustmentType
  label      String?
  amount     Decimal              @db.Decimal(12, 2)
  createdAt  DateTime             @default(now())

  @@index([lineItemId, month])
  @@map("budget_adjustments")
}
