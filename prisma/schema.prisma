// Prisma schema for Plazalar Teknik Hizmetler CRM/CMMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  VIEWER
}

enum OperationType {
  ARIZA
  BAKIM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdRecords MaintenanceRecord[] @relation("RecordCreatedBy")

  @@map("users")
}

model Line {
  id   String @id @default(cuid())
  name String @unique

  machines Machine[]

  @@map("lines")
}

model Machine {
  id                String   @id @default(cuid())
  code              String?  @unique
  name              String   @unique
  lineId            String?
  brand             String?
  model             String?
  serialNo          String?
  quantity          Int      @default(1)
  feature           String?
  powerKw           Float?
  location          String?
  distributionPanel String?
  mccPanel          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  line    Line?               @relation(fields: [lineId], references: [id])
  records MaintenanceRecord[]

  @@index([lineId])
  @@map("machines")
}

model IssueType {
  id   String @id @default(cuid())
  name String @unique

  records MaintenanceRecord[]

  @@map("issue_types")
}

model Technician {
  id   String @id @default(cuid())
  name String @unique

  records MaintenanceRecord[]

  @@map("technicians")
}

model SparePart {
  id          String   @id @default(cuid())
  name        String   @unique
  defaultCost Decimal? @db.Decimal(12, 2)

  records MaintenanceRecord[]

  @@map("spare_parts")
}

model MaintenanceRecord {
  id            String        @id @default(cuid())
  machineId     String
  operationType OperationType
  issueTypeId   String?
  description   String
  technicianId  String?
  reportedAt    DateTime
  respondedAt   DateTime?
  finishedAt    DateTime?
  sparePartId   String?
  sparePartQty  Int?
  sparePartCost Decimal?      @db.Decimal(12, 2)
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  machine    Machine     @relation(fields: [machineId], references: [id])
  issueType  IssueType?  @relation(fields: [issueTypeId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id])
  sparePart  SparePart?  @relation(fields: [sparePartId], references: [id])
  createdBy  User?       @relation("RecordCreatedBy", fields: [createdById], references: [id])

  @@index([machineId])
  @@index([reportedAt])
  @@index([operationType])
  @@map("maintenance_records")
}
