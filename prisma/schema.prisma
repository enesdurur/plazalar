// Prisma schema for Plazalar Teknik Hizmetler CRM/CMMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  VIEWER
}

enum OperationType {
  ARIZA
  BAKIM
}

enum Currency {
  TRY
  USD
  EUR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdRecords MaintenanceRecord[] @relation("RecordCreatedBy")

  @@map("users")
}

model Plaza {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  machines            Machine[]
  periodicInspections PeriodicInspection[]
  tenants             Tenant[]

  @@map("plazas")
}

model Tenant {
  id          String   @id @default(cuid())
  plazaId     String
  floor       String
  companyName String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plaza        Plaza               @relation(fields: [plazaId], references: [id])
  maintenances TenantMaintenance[]

  @@unique([plazaId, floor])
  @@index([plazaId])
  @@map("tenants")
}

model TenantMaintenance {
  id                  String    @id @default(cuid())
  tenantId            String
  maintenanceType     String
  period              String?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  responsiblePerson   String?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([nextMaintenanceDate])
  @@map("tenant_maintenances")
}

model Machine {
  id                String   @id @default(cuid())
  plazaId           String
  name              String
  brand             String?
  model             String?
  serialNo          String?
  quantity          Int      @default(1)
  feature           String?
  powerKw           Float?
  location          String?
  distributionPanel String?
  mccPanel          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plaza       Plaza                  @relation(fields: [plazaId], references: [id])
  records     MaintenanceRecord[]
  planEntries MaintenancePlanEntry[]

  @@unique([plazaId, name])
  @@map("machines")
}

model MaintenancePlanEntry {
  id        String   @id @default(cuid())
  machineId String
  year      Int
  month     Int
  // null = not tracked yet, true = yapıldı, false = yapılmadı
  completed Boolean?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, year, month])
  @@index([year, month])
  @@map("maintenance_plan_entries")
}

model IssueType {
  id   String @id @default(cuid())
  name String @unique

  records MaintenanceRecord[]

  @@map("issue_types")
}

model Technician {
  id   String @id @default(cuid())
  name String @unique

  records MaintenanceRecord[]

  @@map("technicians")
}

model SparePart {
  id          String   @id @default(cuid())
  name        String   @unique
  defaultCost Decimal? @db.Decimal(12, 2)

  records MaintenanceRecord[]

  @@map("spare_parts")
}

model MaintenanceRecord {
  id                    String        @id @default(cuid())
  machineId             String
  operationType         OperationType
  issueTypeId           String?
  description           String
  technicianId          String?
  reportedAt            DateTime
  respondedAt           DateTime?
  finishedAt            DateTime?
  sparePartId           String?
  sparePartOther        String?
  sparePartQty          Int?
  sparePartCost         Decimal?      @db.Decimal(12, 2)
  sparePartCostCurrency Currency      @default(TRY)
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  machine    Machine     @relation(fields: [machineId], references: [id])
  issueType  IssueType?  @relation(fields: [issueTypeId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id])
  sparePart  SparePart?  @relation(fields: [sparePartId], references: [id])
  createdBy  User?       @relation("RecordCreatedBy", fields: [createdById], references: [id])

  @@index([machineId])
  @@index([reportedAt])
  @@index([operationType])
  @@map("maintenance_records")
}

model PeriodicInspection {
  id                 String    @id @default(cuid())
  plazaId            String
  code               String?
  name               String
  brand              String?
  reportNo           Int?
  period             String?
  technicalFeature   String?
  inspectionDate     DateTime?
  nextInspectionDate DateTime?
  location           String?
  responsiblePerson  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plaza Plaza @relation(fields: [plazaId], references: [id])

  @@index([plazaId])
  @@index([nextInspectionDate])
  @@map("periodic_inspections")
}

model Calibration {
  id                  String    @id @default(cuid())
  code                String?
  deviceName          String
  brand               String?
  model               String?
  serialNo            String?
  calibrationCompany  String?
  certificateNo       String?
  measurementRange    String?
  precision           String?
  lastCalibrationDate DateTime?
  nextCalibrationDate DateTime?
  location            String?
  responsiblePerson   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([nextCalibrationDate])
  @@map("calibrations")
}

model Verification {
  id                     String    @id @default(cuid())
  deviceName             String
  deviceSerialNo         String?
  usageLocation          String?
  receivedBy             String?
  verificationPeriod     String?
  referenceCertificateNo String?
  measurementRange       String?
  result                 String?
  verificationDate       DateTime?
  nextVerificationDate   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([nextVerificationDate])
  @@map("verifications")
}
