// Prisma schema for Plazalar Teknik Hizmetler CRM/CMMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  STPU
  TEKNIKER
  MANAGEMENT_DIRECTOR
  VIEWER
}

enum AttachmentKind {
  INVOICE
  MAINTENANCE_FORM
}

enum OperationType {
  ARIZA
  BAKIM
}

enum Currency {
  TRY
  USD
  EUR
}

// Bir müşteri firma (kiracı sınırı). v1'de her User/Plaza tek bir Organization'a bağlı,
// çoklu üyelik yok. isPlatformAdmin bu fazda salt veri bayrağı — hiçbir yerde org filtresini
// bypass etmiyor (platform-admin arayüzü ileriki bir faz).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())

  users       User[]
  plazas      Plaza[]
  issueTypes  IssueType[]
  technicians Technician[]
  spareParts  SparePart[]

  @@map("organizations")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            Role     @default(VIEWER)
  organizationId  String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  createdRecords            MaintenanceRecord[]        @relation("RecordCreatedBy")
  approvedRecords           MaintenanceRecord[]        @relation("RecordApprovedBy")
  approvedPlanEntries       MaintenancePlanWeekEntry[] @relation("PlanEntryApprovedBy")
  approvedInspectionEntries InspectionPlanWeekEntry[]  @relation("InspectionEntryApprovedBy")
  uploadedAttachments       Attachment[]               @relation("AttachmentUploadedBy")
  createdOtherExpenses      OtherExpenseEntry[]        @relation("OtherExpenseCreatedBy")
  approvedOtherExpenses     OtherExpenseEntry[]        @relation("OtherExpenseApprovedBy")

  @@index([organizationId])
  @@map("users")
}

// Bakım/muayene/arıza kayıtlarına eklenen fatura ve bakım formu dosyaları (PDF/görsel).
// Vercel Blob'da saklanır, burada sadece metadata + URL tutulur. Bir kayıt/hafta girdisi
// başına her türden (INVOICE/MAINTENANCE_FORM) en fazla bir aktif dosya olabilir — yeni
// yükleme eskisinin yerine geçer (bkz. src/lib/attachments/service.ts).
model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind
  fileName     String
  fileUrl      String
  mimeType     String
  fileSize     Int
  uploadedById String?
  uploadedAt   DateTime       @default(now())

  planWeekEntryId       String?
  inspectionWeekEntryId String?
  maintenanceRecordId   String?
  otherExpenseEntryId   String?

  planWeekEntry       MaintenancePlanWeekEntry? @relation(fields: [planWeekEntryId], references: [id], onDelete: Cascade)
  inspectionWeekEntry InspectionPlanWeekEntry?  @relation(fields: [inspectionWeekEntryId], references: [id], onDelete: Cascade)
  maintenanceRecord   MaintenanceRecord?        @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  otherExpenseEntry   OtherExpenseEntry?        @relation(fields: [otherExpenseEntryId], references: [id], onDelete: Cascade)
  uploadedBy          User?                     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@unique([planWeekEntryId, kind])
  @@unique([inspectionWeekEntryId, kind])
  @@unique([maintenanceRecordId, kind])
  @@unique([otherExpenseEntryId, kind])
  @@map("attachments")
}

model Plaza {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  machines             Machine[]
  periodicInspections  PeriodicInspection[]
  tenants              Tenant[]
  budgetSections       BudgetSection[]
  maintenancePlanItems MaintenancePlanItem[]
  inspectionPlanItems  InspectionPlanItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("plazas")
}

model Tenant {
  id          String   @id @default(cuid())
  plazaId     String
  floor       String
  companyName String
  /**
   * Katın gerçek alanı (m²) — bina kat şeması görselinde ("Görsel" sekmesi) bar
   * uzunluğunu ve GERÇEK ALANLAR sütununu besler. Bilinmiyorsa boş kalabilir.
   */
  areaSqm     Decimal? @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plaza            Plaza                   @relation(fields: [plazaId], references: [id])
  maintenances     TenantMaintenance[]
  maintenanceItems TenantMaintenanceItem[]

  @@unique([plazaId, floor])
  @@index([plazaId])
  @@map("tenants")
}

// Kiracı Bakımları: Yıllık Bakım Planı / Periyodik (Fenni) Muayene ile aynı desen — her kiracı
// için bakım türü (Fancoil Bakımı, Elektrik Bakımı gibi; liste ileride genişleyebilir) bir
// TenantMaintenanceItem'dır ve haftalık (1-53) matris ile takip edilir.
model TenantMaintenanceItem {
  id             String   @id @default(cuid())
  tenantId       String
  label          String
  scheduledWeeks Int[]    @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekEntries TenantMaintenanceWeekEntry[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("tenant_maintenance_items")
}

model TenantMaintenanceWeekEntry {
  id        String   @id @default(cuid())
  itemId    String
  year      Int
  week      Int
  completed Boolean?
  note      String?
  updatedAt DateTime @updatedAt

  item TenantMaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, year, week])
  @@index([year, week])
  @@map("tenant_maintenance_week_entries")
}

model TenantMaintenance {
  id                  String    @id @default(cuid())
  tenantId            String
  maintenanceType     String
  period              String?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  responsiblePerson   String?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([nextMaintenanceDate])
  @@map("tenant_maintenances")
}

model Machine {
  id                String   @id @default(cuid())
  plazaId           String
  name              String
  brand             String?
  model             String?
  serialNo          String?
  quantity          Int      @default(1)
  feature           String?
  powerKw           Float?
  location          String?
  distributionPanel String?
  mccPanel          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plaza                Plaza                  @relation(fields: [plazaId], references: [id])
  records              MaintenanceRecord[]
  planEntries          MaintenancePlanEntry[]
  maintenancePlanItems MaintenancePlanItem[]
  inspectionPlanItems  InspectionPlanItem[]

  @@unique([plazaId, name])
  @@map("machines")
}

model MaintenancePlanEntry {
  id           String   @id @default(cuid())
  machineId    String
  year         Int
  month        Int
  // null = not tracked yet, true = yapıldı, false = yapılmadı
  completed    Boolean?
  note         String?
  cost         Decimal? @db.Decimal(12, 2)
  costCurrency Currency @default(TRY)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, year, month])
  @@index([year, month])
  @@map("maintenance_plan_entries")
}

model IssueType {
  id             String @id @default(cuid())
  name           String
  organizationId String

  organization Organization        @relation(fields: [organizationId], references: [id])
  records      MaintenanceRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("issue_types")
}

model Technician {
  id             String @id @default(cuid())
  name           String
  organizationId String

  organization Organization        @relation(fields: [organizationId], references: [id])
  records      MaintenanceRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("technicians")
}

model SparePart {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  defaultCost    Decimal? @db.Decimal(12, 2)

  organization Organization        @relation(fields: [organizationId], references: [id])
  records      MaintenanceRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("spare_parts")
}

model MaintenanceRecord {
  id                    String        @id @default(cuid())
  machineId             String
  operationType         OperationType
  issueTypeId           String?
  description           String
  technicianId          String?
  reportedAt            DateTime
  respondedAt           DateTime?
  finishedAt            DateTime?
  sparePartId           String?
  sparePartOther        String?
  sparePartQty          Int?
  sparePartCost         Decimal?      @db.Decimal(12, 2)
  sparePartCostCurrency Currency      @default(TRY)
  /**
   * sparePartCostCurrency TRY değilse, gerçekleşen bütçeye TL karşılığıyla yansıtabilmek için
   * elle girilen kur (1 birim [USD/EUR] = ? TL). TRY girişlerde kullanılmaz.
   */
  sparePartExchangeRate Decimal?      @db.Decimal(10, 4)
  createdById           String?
  /**
   * Arıza kayıtlarındaki yedek parça maliyeti, Yönetim Müdürü onaylamadan Gerçekleşen
   * Bütçe'ye yansımaz (bkz. src/lib/budget/auto-sync.ts). Maliyet her düzenlendiğinde
   * yeniden onaya düşer (approved=false'a döner).
   */
  approved              Boolean       @default(false)
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  machine     Machine      @relation(fields: [machineId], references: [id])
  issueType   IssueType?   @relation(fields: [issueTypeId], references: [id])
  technician  Technician?  @relation(fields: [technicianId], references: [id])
  sparePart   SparePart?   @relation(fields: [sparePartId], references: [id])
  createdBy   User?        @relation("RecordCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?        @relation("RecordApprovedBy", fields: [approvedById], references: [id])
  attachments Attachment[]

  @@index([machineId])
  @@index([reportedAt])
  @@index([operationType])
  @@map("maintenance_records")
}

model PeriodicInspection {
  id                 String    @id @default(cuid())
  plazaId            String
  code               String?
  name               String
  brand              String?
  reportNo           Int?
  period             String?
  technicalFeature   String?
  inspectionDate     DateTime?
  nextInspectionDate DateTime?
  location           String?
  responsiblePerson  String?
  cost               Decimal?  @db.Decimal(12, 2)
  costCurrency       Currency  @default(TRY)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plaza Plaza @relation(fields: [plazaId], references: [id])

  @@index([plazaId])
  @@index([nextInspectionDate])
  @@map("periodic_inspections")
}

// Yıllık Bakım Planı: Excel'deki "BAKIM" listesiyle birebir — her kalem (ör. Trafo İşletme
// Sorumluluğu, Jeneratör Bakımı) bir bakım firmasına ve yıllık tekrar sayısına sahip, isteğe
// bağlı olarak mevcut bir Machine kaydına bağlanabilir. Haftalık (1-53) matris ile takip edilir.
model MaintenancePlanItem {
  id             String   @id @default(cuid())
  plazaId        String
  machineId      String?
  label          String
  company        String?
  yearlyCount    Int?
  /**
   * Excel'de renkli/işaretli hücrelerin karşılık geldiği hafta numaraları (1-53) — bu kalemin
   * o yıl için planlanmış gerçekleşme haftaları. Yalnızca bu haftalarda onay kutusu gösterilir.
   */
  scheduledWeeks Int[]    @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plaza       Plaza                      @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  machine     Machine?                   @relation(fields: [machineId], references: [id])
  weekEntries MaintenancePlanWeekEntry[]

  @@unique([plazaId, label])
  @@index([plazaId])
  @@map("maintenance_plan_items")
}

model MaintenancePlanWeekEntry {
  id                    String    @id @default(cuid())
  itemId                String
  year                  Int
  /**
   * 1-53: Excel'deki aylara bölünmüş hafta numarası (bkz. lib/plan/weeks.ts)
   */
  week                  Int
  // null = boş, true = yapıldı, false = yapılmadı
  completed             Boolean?
  note                  String?
  cost                  Decimal?  @db.Decimal(12, 2)
  costCurrency          Currency  @default(TRY)
  /**
   * costCurrency TRY değilse, gerçekleşen bütçeye TL karşılığıyla yansıtabilmek için elle
   * girilen kur (1 birim [USD/EUR] = ? TL). TRY girişlerde kullanılmaz.
   */
  costExchangeRate      Decimal?  @db.Decimal(10, 4)
  /**
   * Bu bakımda kullanılan yedek parça varsa: maliyet + not. sparePartCost dolu olduğunda
   * matriste ayrı bir işaret gösterilir.
   */
  sparePartCost         Decimal?  @db.Decimal(12, 2)
  sparePartCostCurrency Currency  @default(TRY)
  sparePartExchangeRate Decimal?  @db.Decimal(10, 4)
  sparePartNote         String?
  /**
   * Bakım/yedek parça maliyeti, Yönetim Müdürü onaylamadan Gerçekleşen Bütçe'ye yansımaz
   * (bkz. src/lib/budget/auto-sync.ts). Maliyet her düzenlendiğinde yeniden onaya düşer.
   */
  approved              Boolean   @default(false)
  approvedById          String?
  approvedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  item        MaintenancePlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  approvedBy  User?               @relation("PlanEntryApprovedBy", fields: [approvedById], references: [id])
  attachments Attachment[]

  @@unique([itemId, year, week])
  @@index([year, week])
  @@map("maintenance_plan_week_entries")
}

// Periyodik (Fenni) Muayene: Excel'deki "FENNİ MUAYENE" listesiyle birebir — aynı haftalık
// (1-53) matris deseni, MaintenancePlanItem ile paralel ama ayrı bir model (farklı sekme/anlam).
model InspectionPlanItem {
  id             String   @id @default(cuid())
  plazaId        String
  machineId      String?
  label          String
  company        String?
  yearlyCount    Int?
  /**
   * Excel'de renkli/işaretli hücrelerin karşılık geldiği hafta numaraları (1-53).
   */
  scheduledWeeks Int[]    @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plaza       Plaza                     @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  machine     Machine?                  @relation(fields: [machineId], references: [id])
  weekEntries InspectionPlanWeekEntry[]

  @@unique([plazaId, label])
  @@index([plazaId])
  @@map("inspection_plan_items")
}

model InspectionPlanWeekEntry {
  id                    String    @id @default(cuid())
  itemId                String
  year                  Int
  week                  Int
  completed             Boolean?
  note                  String?
  cost                  Decimal?  @db.Decimal(12, 2)
  costCurrency          Currency  @default(TRY)
  costExchangeRate      Decimal?  @db.Decimal(10, 4)
  sparePartCost         Decimal?  @db.Decimal(12, 2)
  sparePartCostCurrency Currency  @default(TRY)
  sparePartExchangeRate Decimal?  @db.Decimal(10, 4)
  sparePartNote         String?
  /**
   * Muayene/yedek parça maliyeti, Yönetim Müdürü onaylamadan Gerçekleşen Bütçe'ye yansımaz
   * (bkz. src/lib/budget/auto-sync.ts). Maliyet her düzenlendiğinde yeniden onaya düşer.
   */
  approved              Boolean   @default(false)
  approvedById          String?
  approvedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  item        InspectionPlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  approvedBy  User?              @relation("InspectionEntryApprovedBy", fields: [approvedById], references: [id])
  attachments Attachment[]

  @@unique([itemId, year, week])
  @@index([year, week])
  @@map("inspection_plan_week_entries")
}

// Gerçekleşen Bütçe: bölüm (A- Personel Giderleri, Yönetim Giderleri, Diğer Giderler gibi)
// bazında gider kalemleri. Her kalem ya "sözleşme bedeli belirli" (isFixedContract) olur —
// yıl başında fixedAmount girilir, sonraki aylarda sadece onay kutusu işaretlenir — ya da
// tutar her ay elle girilir (manualAmount).
model BudgetSection {
  id        String   @id @default(cuid())
  plazaId   String
  plaza     Plaza    @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  year      Int
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items BudgetLineItem[]

  @@unique([plazaId, year, name])
  @@map("budget_sections")
}

model BudgetLineItem {
  id              String            @id @default(cuid())
  sectionId       String
  section         BudgetSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category        String?
  label           String
  monthlyBudget   Decimal           @db.Decimal(12, 2)
  isFixedContract Boolean           @default(false)
  fixedAmount     Decimal?          @db.Decimal(12, 2)
  fill            String?
  sortOrder       Int               @default(0)
  /**
   * Doluysa bu kalemin aylık tutarı 3. Firma Bakım Planı / Periyodik Muayene / Arıza
   * Kayıtları'na girilen (ve onaylanan) maliyetlerden otomatik hesaplanır (bkz.
   * src/lib/budget/auto-sync.ts). Bu 3 modülün fatura/form yükleme ve bina yöneticisi onayı
   * hem kendi sayfalarından hem de Diğer Giderler sayfasının alt kısmından yapılabilir — ikisi
   * de aynı alttaki kayıtları gösterip düzenler. Plaza+yıl başına her kaynak için tek kalem
   * olabilir.
   */
  autoSource      BudgetAutoSource?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  entries            BudgetMonthEntry[]
  adjustments        BudgetAdjustment[]
  otherExpenseEntries OtherExpenseEntry[]

  @@unique([sectionId, label])
  @@map("budget_line_items")
}

enum BudgetAutoSource {
  MAINTENANCE_PLAN
  INSPECTION
  FAULT_RECORDS
}

// "DİĞER GİDERLER" bölümündeki, autoSource'u olmayan (Ortak Alan Elektrik, Peyzaj vb. gibi
// gerçekten elle girilen) kalemlerin veri girişi buradan yapılır: her fatura/gider kaydı kendi
// tutarı + destekleyici belgesiyle (fatura/form) girilir ve bina yöneticisi (canApprove)
// onayından geçmeden Gerçekleşen Bütçe'ye yansımaz (bkz. src/lib/budget/other-expense-sync.ts).
// Bir kalem+ay için birden fazla kayıt olabilir (aynı ay içinde birden fazla fatura) — onaylı
// olanların toplamı o ayın tutarını oluşturur.
model OtherExpenseEntry {
  id           String         @id @default(cuid())
  lineItemId   String
  lineItem     BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  month        Int
  amount       Decimal        @db.Decimal(12, 2)
  note         String?
  createdById  String?
  createdBy    User?          @relation("OtherExpenseCreatedBy", fields: [createdById], references: [id])
  approved     Boolean        @default(false)
  approvedById String?
  approvedBy   User?          @relation("OtherExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attachments Attachment[]

  @@index([lineItemId, month])
  @@map("other_expense_entries")
}

model BudgetMonthEntry {
  id           String         @id @default(cuid())
  lineItemId   String
  lineItem     BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  month        Int
  /**
   * Sözleşme bedeli sabit kalemlerde: bu ay gerçekleşti mi (onay kutusu)
   */
  confirmed    Boolean        @default(false)
  /**
   * Sabit olmayan kalemlerde elle girilen tutar
   */
  manualAmount Decimal?       @db.Decimal(12, 2)
  updatedAt    DateTime       @updatedAt

  @@unique([lineItemId, month])
  @@map("budget_month_entries")
}

enum BudgetAdjustmentType {
  OVERTIME
  ABSENCE
}

/**
 * Sözleşmesi sabit bir kalemde bile o ay için ek kırılım (fazla mesai / eksik çalışma)
 * gerekebilir. OVERTIME kalemin ay tutarına eklenir, ABSENCE düşülür.
 */
model BudgetAdjustment {
  id         String               @id @default(cuid())
  lineItemId String
  lineItem   BudgetLineItem       @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  month      Int
  type       BudgetAdjustmentType
  label      String?
  amount     Decimal              @db.Decimal(12, 2)
  createdAt  DateTime             @default(now())

  @@index([lineItemId, month])
  @@map("budget_adjustments")
}
